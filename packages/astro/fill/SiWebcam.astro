---
const { title, ...rest } = Astro.props;
const inner = "<path fill=\"currentColor\" d=\"M12 9a1 1 0 1 0 0 2 1 1 0 0 0 0-2\"/><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M12 1a9 9 0 0 0-1 17.945V21H6a1 1 0 1 0 0 2h12a1 1 0 1 0 0-2h-5v-2.055A9.001 9.001 0 0 0 12 1m-3 9a3 3 0 1 1 6 0 3 3 0 0 1-6 0\" clip-rule=\"evenodd\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
