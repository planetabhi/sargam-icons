---
const { title, ...rest } = Astro.props;
const inner = "<path fill=\"currentColor\" d=\"M4 9a1 1 0 0 0 0 2h16a1 1 0 1 0 0-2zM4 13a1 1 0 1 0 0 2h16a1 1 0 1 0 0-2z\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
