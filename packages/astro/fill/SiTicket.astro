---
const { title, ...rest } = Astro.props;
const inner = "<path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M20.8 4A2.2 2.2 0 0 1 23 6.2V9a1 1 0 0 1-1 1 2 2 0 1 0 0 4 1 1 0 0 1 1 1v2.8a2.2 2.2 0 0 1-2.2 2.2H3.2A2.2 2.2 0 0 1 1 17.8V15a1 1 0 0 1 1-1 2 2 0 1 0 0-4 1 1 0 0 1-1-1V6.2A2.2 2.2 0 0 1 3.2 4zM8 15h8V9H8z\" clip-rule=\"evenodd\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
