---
const { title, ...rest } = Astro.props;
const inner = "<path fill=\"currentColor\" d=\"M3 5a1 1 0 0 0 0 2h18a1 1 0 1 0 0-2zM3 9a1 1 0 0 0 0 2h12a1 1 0 1 0 0-2zM2 14a1 1 0 0 1 1-1h18a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1M3 17a1 1 0 1 0 0 2h12a1 1 0 1 0 0-2z\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
