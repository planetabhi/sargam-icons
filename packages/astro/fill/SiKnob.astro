---
const { title, ...rest } = Astro.props;
const inner = "<path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M12 7a8 8 0 1 1 0 16 8 8 0 0 1 0-16m4.707 3.293a1 1 0 0 0-1.414 0l-4 4a1 1 0 1 0 1.414 1.414l4-4a1 1 0 0 0 0-1.414\" clip-rule=\"evenodd\"/><path fill=\"currentColor\" d=\"M5 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4M19 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4M12 1a2 2 0 1 1 0 4 2 2 0 0 1 0-4\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
