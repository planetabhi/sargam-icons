---
const { title, ...rest } = Astro.props;
const inner = "<path stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-miterlimit=\"10\" stroke-width=\"1.5\" d=\"M17 6H7a6 6 0 1 0 0 12h10a6 6 0 0 0 0-12Z\"/><path stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-miterlimit=\"10\" stroke-width=\"1.5\" d=\"M7 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z\"/>";
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  fill="none"
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={inner} />
</svg>
